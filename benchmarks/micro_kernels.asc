#include <algorithm>
#include <cstdint>
#include "kernel_operator.h"

namespace AddRmsNormBiasMicro {

constexpr uint32_t BLOCK_BYTES = 32;
constexpr uint32_t COPY_TILE_ELEMENTS = 4096;
constexpr uint32_t REDUCE_TILE_ELEMENTS = 4096;

enum class VectorBenchOp : int32_t { ADD = 0, MUL = 1 };

template <typename T>
__aicore__ inline uint32_t AlignElements(uint32_t count)
{
    const uint32_t elementsPerBlock = BLOCK_BYTES / sizeof(T);
    return (count + elementsPerBlock - 1) / elementsPerBlock * elementsPerBlock;
}

template <typename T>
__aicore__ inline void CopyGmToUb(AscendC::LocalTensor<T> dst,
                                  AscendC::GlobalTensor<T> src,
                                  uint64_t offset, uint32_t valid,
                                  uint32_t aligned)
{
    const uint64_t byteOffset = offset * sizeof(T);
    if (valid == aligned && (byteOffset & (BLOCK_BYTES - 1)) == 0) {
        AscendC::DataCopy(dst, src[offset], aligned);
        return;
    }
    AscendC::DataCopyExtParams copyParams{
        1, static_cast<uint32_t>(valid * sizeof(T)), 0, 0, 0};
    AscendC::DataCopyPadExtParams<T> padParams{
        true, 0, static_cast<uint8_t>(aligned - valid), static_cast<T>(0)};
    AscendC::DataCopyPad(dst, src[offset], copyParams, padParams);
}

template <typename T>
__aicore__ inline void CopyUbToGm(AscendC::GlobalTensor<T> dst,
                                  AscendC::LocalTensor<T> src,
                                  uint64_t offset, uint32_t valid,
                                  uint32_t aligned)
{
    const uint64_t byteOffset = offset * sizeof(T);
    if (valid == aligned && (byteOffset & (BLOCK_BYTES - 1)) == 0) {
        AscendC::DataCopy(dst[offset], src, valid);
        return;
    }
    AscendC::DataCopyExtParams copyParams{
        1, static_cast<uint32_t>(valid * sizeof(T)), 0, 0, 0};
    AscendC::DataCopyPad(dst[offset], src, copyParams);
}

__aicore__ inline void PartitionBlocks(uint64_t elements,
                                       uint32_t elementsPerBlock,
                                       uint64_t &firstElement,
                                       uint64_t &elementsForCore)
{
    const uint64_t totalBlocks =
        (elements + elementsPerBlock - 1) / elementsPerBlock;
    const uint64_t coreCount = AscendC::GetBlockNum();
    const uint64_t coreIndex = AscendC::GetBlockIdx();
    const uint64_t baseBlocks = totalBlocks / coreCount;
    const uint64_t extraBlocks = totalBlocks % coreCount;
    const uint64_t blocksForCore =
        baseBlocks + (coreIndex < extraBlocks ? 1 : 0);
    const uint64_t firstBlock = coreIndex * baseBlocks +
        (coreIndex < extraBlocks ? coreIndex : extraBlocks);
    firstElement = firstBlock * elementsPerBlock;
    const uint64_t capacity = blocksForCore * elementsPerBlock;
    elementsForCore = firstElement < elements
        ? (elements - firstElement < capacity ? elements - firstElement : capacity)
        : 0;
}

template <typename T>
class GmCopyKernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                uint64_t elements, AscendC::TPipe *pipe)
    {
        elements_ = elements;
        input_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(input), elements);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output), elements);
        pipe->InitBuffer(buffer_, COPY_TILE_ELEMENTS * sizeof(T));
        PartitionBlocks(elements, BLOCK_BYTES / sizeof(T), first_, count_);
    }

    __aicore__ inline void Process()
    {
        auto local = buffer_.Get<T>();
        for (uint64_t done = 0; done < count_; done += COPY_TILE_ELEMENTS) {
            const uint32_t valid = count_ - done < COPY_TILE_ELEMENTS
                ? static_cast<uint32_t>(count_ - done) : COPY_TILE_ELEMENTS;
            const uint32_t aligned = AlignElements<T>(valid);
            CopyGmToUb(local, input_, first_ + done, valid, aligned);
            AscendC::PipeBarrier<PIPE_ALL>();
            CopyUbToGm(output_, local, first_ + done, valid, aligned);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

private:
    AscendC::TBuf<AscendC::QuePosition::VECIN> buffer_;
    AscendC::GlobalTensor<T> input_;
    AscendC::GlobalTensor<T> output_;
    uint64_t elements_ = 0;
    uint64_t first_ = 0;
    uint64_t count_ = 0;
};

template <typename T>
class VectorKernel {
public:
    __aicore__ inline void Init(GM_ADDR lhs, GM_ADDR rhs, GM_ADDR output,
                                uint64_t elements, int32_t op,
                                uint32_t innerRepeats, AscendC::TPipe *pipe)
    {
        op_ = op;
        repeats_ = innerRepeats;
        lhs_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(lhs), elements);
        rhs_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(rhs), elements);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output), elements);
        pipe->InitBuffer(valueA_, COPY_TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(valueB_, COPY_TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(rhsBuffer_, COPY_TILE_ELEMENTS * sizeof(T));
        PartitionBlocks(elements, BLOCK_BYTES / sizeof(T), first_, count_);
    }

    __aicore__ inline void Process()
    {
        auto valueA = valueA_.Get<T>();
        auto valueB = valueB_.Get<T>();
        auto rhsLocal = rhsBuffer_.Get<T>();
        for (uint64_t done = 0; done < count_; done += COPY_TILE_ELEMENTS) {
            const uint32_t valid = count_ - done < COPY_TILE_ELEMENTS
                ? static_cast<uint32_t>(count_ - done) : COPY_TILE_ELEMENTS;
            const uint32_t aligned = AlignElements<T>(valid);
            CopyGmToUb(valueA, lhs_, first_ + done, valid, aligned);
            CopyGmToUb(rhsLocal, rhs_, first_ + done, valid, aligned);
            AscendC::PipeBarrier<PIPE_ALL>();

            for (uint32_t repeat = 0; repeat < repeats_; ++repeat) {
                if ((repeat & 1U) == 0) {
                    if (op_ == static_cast<int32_t>(VectorBenchOp::ADD)) {
                        AscendC::Add(valueB, valueA, rhsLocal, aligned);
                    } else {
                        AscendC::Mul(valueB, valueA, rhsLocal, aligned);
                    }
                } else {
                    if (op_ == static_cast<int32_t>(VectorBenchOp::ADD)) {
                        AscendC::Add(valueA, valueB, rhsLocal, aligned);
                    } else {
                        AscendC::Mul(valueA, valueB, rhsLocal, aligned);
                    }
                }
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            auto result = (repeats_ & 1U) == 0 ? valueA : valueB;
            CopyUbToGm(output_, result, first_ + done, valid, aligned);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

private:
    AscendC::TBuf<AscendC::QuePosition::VECIN> valueA_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> valueB_;
    AscendC::TBuf<AscendC::QuePosition::VECIN> rhsBuffer_;
    AscendC::GlobalTensor<T> lhs_;
    AscendC::GlobalTensor<T> rhs_;
    AscendC::GlobalTensor<T> output_;
    uint64_t first_ = 0;
    uint64_t count_ = 0;
    int32_t op_ = 0;
    uint32_t repeats_ = 1;
};

template <typename T>
__aicore__ inline void LoadAsFloat(AscendC::LocalTensor<float> dst,
                                   AscendC::LocalTensor<T> raw,
                                   AscendC::GlobalTensor<T> src,
                                   uint64_t offset, uint32_t valid,
                                   uint32_t aligned)
{
    CopyGmToUb(raw, src, offset, valid, aligned);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Cast(dst, raw, AscendC::RoundMode::CAST_NONE, aligned);
}

__aicore__ inline void LoadAsFloat(AscendC::LocalTensor<float> dst,
                                   AscendC::LocalTensor<float> raw,
                                   AscendC::GlobalTensor<float> src,
                                   uint64_t offset, uint32_t valid,
                                   uint32_t aligned)
{
    (void)raw;
    CopyGmToUb(dst, src, offset, valid, aligned);
}

template <typename T>
class ReductionKernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR rowSums,
                                uint64_t rows, uint32_t hidden,
                                AscendC::TPipe *pipe)
    {
        rows_ = rows;
        hidden_ = hidden;
        const uint64_t coreCount = AscendC::GetBlockNum();
        const uint64_t coreIndex = AscendC::GetBlockIdx();
        const uint64_t baseRows = rows / coreCount;
        const uint64_t extraRows = rows % coreCount;
        count_ = baseRows + (coreIndex < extraRows ? 1 : 0);
        first_ = coreIndex * baseRows +
            (coreIndex < extraRows ? coreIndex : extraRows);

        input_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(input), rows * hidden);
        sums_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowSums), rows);
        pipe->InitBuffer(rawBuffer_, REDUCE_TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(valueBuffer_, REDUCE_TILE_ELEMENTS * sizeof(float));
        pipe->InitBuffer(squareBuffer_, REDUCE_TILE_ELEMENTS * sizeof(float));
        pipe->InitBuffer(workBuffer_, REDUCE_TILE_ELEMENTS * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        auto raw = rawBuffer_.Get<T>();
        auto value = valueBuffer_.Get<float>();
        auto square = squareBuffer_.Get<float>();
        auto work = workBuffer_.Get<float>();

        for (uint64_t localRow = 0; localRow < count_; ++localRow) {
            const uint64_t row = first_ + localRow;
            const uint64_t rowOffset = row * hidden_;
            float sum = 0.0f;
            for (uint32_t column = 0; column < hidden_;
                 column += REDUCE_TILE_ELEMENTS) {
                const uint32_t valid = hidden_ - column < REDUCE_TILE_ELEMENTS
                    ? hidden_ - column : REDUCE_TILE_ELEMENTS;
                const uint32_t aligned = AlignElements<T>(valid);
                LoadAsFloat(value, raw, input_, rowOffset + column,
                            valid, aligned);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(square, value, value, aligned);
                AscendC::ReduceSum<float>(square, square, work, aligned);
                AscendC::PipeBarrier<PIPE_ALL>();
                sum += square.GetValue(0);
            }
            sums_.SetValue(row, sum);
        }
    }

private:
    AscendC::TBuf<AscendC::QuePosition::VECIN> rawBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> valueBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> squareBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> workBuffer_;
    AscendC::GlobalTensor<T> input_;
    AscendC::GlobalTensor<float> sums_;
    uint64_t rows_ = 0;
    uint64_t first_ = 0;
    uint64_t count_ = 0;
    uint32_t hidden_ = 0;
};

} // namespace AddRmsNormBiasMicro

using VectorBenchOp = AddRmsNormBiasMicro::VectorBenchOp;

extern "C" __global__ __vector__ void addrmsnormbias_noop_benchmark(
    GM_ADDR checksum)
{
    if (AscendC::GetBlockIdx() == 0) {
        AscendC::GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(checksum), 1);
        output.SetValue(0, 1.0f);
    }
}

extern "C" __global__ __vector__ void addrmsnormbias_gm_copy_benchmark(
    GM_ADDR input, GM_ADDR output, uint64_t elements, int32_t dtype)
{
    AscendC::TPipe pipe;
    if (dtype == 0) {
        AddRmsNormBiasMicro::GmCopyKernel<float> kernel;
        kernel.Init(input, output, elements, &pipe);
        kernel.Process();
    } else if (dtype == 1) {
        AddRmsNormBiasMicro::GmCopyKernel<half> kernel;
        kernel.Init(input, output, elements, &pipe);
        kernel.Process();
    } else if (dtype == 2) {
        AddRmsNormBiasMicro::GmCopyKernel<bfloat16_t> kernel;
        kernel.Init(input, output, elements, &pipe);
        kernel.Process();
    }
}

extern "C" __global__ __vector__ void addrmsnormbias_vector_benchmark(
    GM_ADDR lhs, GM_ADDR rhs, GM_ADDR output, uint64_t elements,
    int32_t dtype, int32_t op, uint32_t innerRepeats)
{
    AscendC::TPipe pipe;
    if (dtype == 0) {
        AddRmsNormBiasMicro::VectorKernel<float> kernel;
        kernel.Init(lhs, rhs, output, elements, op, innerRepeats, &pipe);
        kernel.Process();
    } else if (dtype == 1) {
        AddRmsNormBiasMicro::VectorKernel<half> kernel;
        kernel.Init(lhs, rhs, output, elements, op, innerRepeats, &pipe);
        kernel.Process();
    }
}

extern "C" __global__ __vector__ void addrmsnormbias_reduction_benchmark(
    GM_ADDR input, GM_ADDR rowSums, uint64_t rows, uint32_t hidden,
    int32_t inputDtype)
{
    AscendC::TPipe pipe;
    if (inputDtype == 0) {
        AddRmsNormBiasMicro::ReductionKernel<float> kernel;
        kernel.Init(input, rowSums, rows, hidden, &pipe);
        kernel.Process();
    } else if (inputDtype == 1) {
        AddRmsNormBiasMicro::ReductionKernel<half> kernel;
        kernel.Init(input, rowSums, rows, hidden, &pipe);
        kernel.Process();
    } else if (inputDtype == 2) {
        AddRmsNormBiasMicro::ReductionKernel<bfloat16_t> kernel;
        kernel.Init(input, rowSums, rows, hidden, &pipe);
        kernel.Process();
    }
}

extern "C" void launch_noop_benchmark(GM_ADDR checksum,
                                       aclrtStream stream)
{
    addrmsnormbias_noop_benchmark<<<1, nullptr, stream>>>(checksum);
}

extern "C" void launch_gm_copy_benchmark(GM_ADDR input, GM_ADDR output,
                                          uint64_t elements, int32_t dtype,
                                          int64_t availableCoreNum,
                                          aclrtStream stream)
{
    const uint32_t elementBytes = dtype == 0 ? 4U : 2U;
    const uint64_t elementsPerBlock =
        AddRmsNormBiasMicro::BLOCK_BYTES / elementBytes;
    const uint64_t blocks = (elements + elementsPerBlock - 1) / elementsPerBlock;
    const uint32_t blockNum = static_cast<uint32_t>(
        std::min<uint64_t>(blocks, static_cast<uint64_t>(availableCoreNum)));
    addrmsnormbias_gm_copy_benchmark<<<blockNum, nullptr, stream>>>(
        input, output, elements, dtype);
}

extern "C" void launch_vector_benchmark(
    GM_ADDR lhs, GM_ADDR rhs, GM_ADDR output, uint64_t elements,
    int32_t dtype, VectorBenchOp op, uint32_t innerRepeats,
    int64_t availableCoreNum, aclrtStream stream)
{
    const uint32_t elementBytes = dtype == 0 ? 4U : 2U;
    const uint64_t elementsPerBlock =
        AddRmsNormBiasMicro::BLOCK_BYTES / elementBytes;
    const uint64_t blocks = (elements + elementsPerBlock - 1) / elementsPerBlock;
    const uint32_t blockNum = static_cast<uint32_t>(
        std::min<uint64_t>(blocks, static_cast<uint64_t>(availableCoreNum)));
    addrmsnormbias_vector_benchmark<<<blockNum, nullptr, stream>>>(
        lhs, rhs, output, elements, dtype, static_cast<int32_t>(op),
        innerRepeats);
}

extern "C" void launch_reduction_benchmark(
    GM_ADDR input, GM_ADDR rowSums, uint64_t rows, uint32_t hidden,
    int32_t inputDtype, int64_t availableCoreNum, aclrtStream stream)
{
    const uint32_t blockNum = static_cast<uint32_t>(
        std::min<uint64_t>(rows, static_cast<uint64_t>(availableCoreNum)));
    addrmsnormbias_reduction_benchmark<<<blockNum, nullptr, stream>>>(
        input, rowSums, rows, hidden, inputDtype);
}

#include <algorithm>
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

/*
 * Frozen AddRmsNormBias baseline for hardware A/B measurements.
 * Dimensions before the last one are flattened into rows. Each row belongs to
 * one vector core, making the reduction deterministic and workspace-free.
 */

namespace AddRmsNormBiasBaseline {

constexpr uint32_t BLOCK_BYTES = 32;
constexpr uint32_t MAX_TILE_ELEMENTS = 4096;

template <typename T>
__aicore__ inline void ConvertToFloat(AscendC::LocalTensor<float> dst,
                                      AscendC::LocalTensor<T> src,
                                      uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

__aicore__ inline void ConvertToFloat(AscendC::LocalTensor<float> dst,
                                      AscendC::LocalTensor<float> src,
                                      uint32_t count)
{
    AscendC::Muls(dst, src, 1.0f, count);
}

__aicore__ inline void ConvertFromFloat(AscendC::LocalTensor<half> dst,
                                        AscendC::LocalTensor<float> src,
                                        uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

__aicore__ inline void ConvertFromFloat(AscendC::LocalTensor<bfloat16_t> dst,
                                        AscendC::LocalTensor<float> src,
                                        uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_RINT, count);
}

__aicore__ inline void ConvertFromFloat(AscendC::LocalTensor<float> dst,
                                        AscendC::LocalTensor<float> src,
                                        uint32_t count)
{
    AscendC::Muls(dst, src, 1.0f, count);
}

template <typename T>
__aicore__ inline void MakeResidualSum(AscendC::LocalTensor<float> dst,
                                       AscendC::LocalTensor<float> tmp,
                                       AscendC::LocalTensor<T> x,
                                       AscendC::LocalTensor<T> residual,
                                       uint32_t count)
{
    ConvertToFloat(dst, x, count);
    ConvertToFloat(tmp, residual, count);
    AscendC::Add(dst, dst, tmp, count);
}

__aicore__ inline void MakeResidualSum(AscendC::LocalTensor<float> dst,
                                       AscendC::LocalTensor<float> tmp,
                                       AscendC::LocalTensor<float> x,
                                       AscendC::LocalTensor<float> residual,
                                       uint32_t count)
{
    (void)tmp;
    AscendC::Add(dst, x, residual, count);
}

template <typename T>
__aicore__ inline void ApplyGammaBias(AscendC::LocalTensor<float> y,
                                      AscendC::LocalTensor<float> tmp,
                                      AscendC::LocalTensor<T> gamma,
                                      AscendC::LocalTensor<T> bias,
                                      uint32_t count)
{
    ConvertToFloat(tmp, gamma, count);
    AscendC::Mul(y, y, tmp, count);
    ConvertToFloat(tmp, bias, count);
    AscendC::Add(y, y, tmp, count);
}

__aicore__ inline void ApplyGammaBias(AscendC::LocalTensor<float> y,
                                      AscendC::LocalTensor<float> tmp,
                                      AscendC::LocalTensor<float> gamma,
                                      AscendC::LocalTensor<float> bias,
                                      uint32_t count)
{
    (void)tmp;
    AscendC::Mul(y, y, gamma, count);
    AscendC::Add(y, y, bias, count);
}

template <typename T>
class KernelAddRmsNormBias {
public:
    __aicore__ inline KernelAddRmsNormBias() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR output,
                                uint64_t rowCount, uint32_t hiddenSize,
                                uint32_t tileElements, float epsilon,
                                float reciprocalD, AscendC::TPipe *pipe)
    {
        rowCount_ = rowCount;
        hiddenSize_ = hiddenSize;
        tileElements_ = tileElements;
        epsilon_ = epsilon;
        reciprocalD_ = reciprocalD;
        pipe_ = pipe;

        uint32_t coreCount = AscendC::GetBlockNum();
        uint32_t coreIndex = AscendC::GetBlockIdx();
        uint64_t baseRows = rowCount / coreCount;
        uint64_t extraRows = rowCount % coreCount;
        rowsForCore_ = baseRows + (coreIndex < extraRows ? 1 : 0);
        firstRow_ = coreIndex * baseRows +
                    (coreIndex < extraRows ? coreIndex : extraRows);

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), rowCount * hiddenSize);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual),
                                    rowCount * hiddenSize);
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), hiddenSize);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bias), hiddenSize);
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output),
                                  rowCount * hiddenSize);

        pipe_->InitBuffer(xBuffer_, tileElements * sizeof(T));
        pipe_->InitBuffer(residualBuffer_, tileElements * sizeof(T));
        pipe_->InitBuffer(gammaBuffer_, tileElements * sizeof(T));
        pipe_->InitBuffer(biasBuffer_, tileElements * sizeof(T));
        pipe_->InitBuffer(outputBuffer_, tileElements * sizeof(T));
        pipe_->InitBuffer(calcBuffer_, 3 * tileElements * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint64_t localRow = 0; localRow < rowsForCore_; ++localRow) {
            ProcessRow(firstRow_ + localRow);
        }
    }

private:
    __aicore__ inline uint32_t AlignElements(uint32_t valid) const
    {
        const uint32_t elementsPerBlock = BLOCK_BYTES / sizeof(T);
        return (valid + elementsPerBlock - 1) / elementsPerBlock * elementsPerBlock;
    }

    __aicore__ inline void CopyInput(AscendC::LocalTensor<T> dst,
                                     AscendC::GlobalTensor<T> src,
                                     uint64_t offset, uint32_t valid,
                                     uint32_t aligned)
    {
        const uint64_t byteOffset = offset * sizeof(T);
        if (valid == aligned && (byteOffset & (BLOCK_BYTES - 1)) == 0) {
            AscendC::DataCopy(dst, src[offset], aligned);
            return;
        }
        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(valid * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(aligned - valid), static_cast<T>(0)};
        AscendC::DataCopyPad(dst, src[offset], copyParams, padParams);
    }

    __aicore__ inline void CopyOutput(AscendC::GlobalTensor<T> dst,
                                      AscendC::LocalTensor<T> src,
                                      uint64_t offset, uint32_t valid,
                                      uint32_t aligned)
    {
        const uint64_t byteOffset = offset * sizeof(T);
        if (valid == aligned && (byteOffset & (BLOCK_BYTES - 1)) == 0) {
            AscendC::DataCopy(dst[offset], src, valid);
            return;
        }
        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(valid * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(dst[offset], src, copyParams);
    }

    __aicore__ inline float ReduceTile(uint64_t rowOffset,
                                       uint32_t columnOffset,
                                       uint32_t valid,
                                       uint32_t aligned)
    {
        auto xLocal = xBuffer_.Get<T>();
        auto residualLocal = residualBuffer_.Get<T>();
        auto calc = calcBuffer_.Get<float>();
        auto yLocal = calc[0];
        auto squareLocal = calc[tileElements_];
        auto workLocal = calc[2 * tileElements_];

        CopyInput(xLocal, xGm_, rowOffset + columnOffset, valid, aligned);
        CopyInput(residualLocal, residualGm_, rowOffset + columnOffset, valid, aligned);
        AscendC::PipeBarrier<PIPE_ALL>();

        MakeResidualSum(yLocal, squareLocal, xLocal, residualLocal, aligned);
        AscendC::Mul(squareLocal, yLocal, yLocal, aligned);
        AscendC::ReduceSum<float>(squareLocal, squareLocal, workLocal, aligned);
        AscendC::PipeBarrier<PIPE_ALL>();
        return squareLocal.GetValue(0);
    }

    __aicore__ inline void WriteSingleTile(uint64_t rowOffset,
                                           uint32_t valid,
                                           uint32_t aligned,
                                           float scale)
    {
        auto gammaLocal = gammaBuffer_.Get<T>();
        auto biasLocal = biasBuffer_.Get<T>();
        auto outputLocal = outputBuffer_.Get<T>();
        auto calc = calcBuffer_.Get<float>();
        auto yLocal = calc[0];
        auto parameterLocal = calc[tileElements_];

        const bool didCopy = !parametersCached_;
        if (didCopy) {
            CopyInput(gammaLocal, gammaGm_, 0, valid, aligned);
            CopyInput(biasLocal, biasGm_, 0, valid, aligned);
        }
        if (didCopy) {
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        AscendC::Muls(yLocal, yLocal, scale, aligned);
        ApplyGammaBias(yLocal, parameterLocal, gammaLocal, biasLocal, aligned);

        ConvertFromFloat(outputLocal, yLocal, aligned);
        AscendC::PipeBarrier<PIPE_ALL>();
        CopyOutput(outputGm_, outputLocal, rowOffset, valid, aligned);
        AscendC::PipeBarrier<PIPE_ALL>();
        parametersCached_ = true;
    }

    __aicore__ inline void WriteTile(uint64_t rowOffset,
                                     uint32_t columnOffset,
                                     uint32_t valid,
                                     uint32_t aligned,
                                     float scale)
    {
        auto xLocal = xBuffer_.Get<T>();
        auto residualLocal = residualBuffer_.Get<T>();
        auto gammaLocal = gammaBuffer_.Get<T>();
        auto biasLocal = biasBuffer_.Get<T>();
        auto outputLocal = outputBuffer_.Get<T>();
        auto calc = calcBuffer_.Get<float>();
        auto yLocal = calc[0];
        auto parameterLocal = calc[tileElements_];

        CopyInput(xLocal, xGm_, rowOffset + columnOffset, valid, aligned);
        CopyInput(residualLocal, residualGm_, rowOffset + columnOffset,
                  valid, aligned);
        CopyInput(gammaLocal, gammaGm_, columnOffset, valid, aligned);
        CopyInput(biasLocal, biasGm_, columnOffset, valid, aligned);
        AscendC::PipeBarrier<PIPE_ALL>();

        MakeResidualSum(yLocal, parameterLocal, xLocal, residualLocal, aligned);
        AscendC::Muls(yLocal, yLocal, scale, aligned);
        ApplyGammaBias(yLocal, parameterLocal, gammaLocal, biasLocal, aligned);

        ConvertFromFloat(outputLocal, yLocal, aligned);
        AscendC::PipeBarrier<PIPE_ALL>();
        CopyOutput(outputGm_, outputLocal, rowOffset + columnOffset, valid,
                   aligned);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void ProcessRow(uint64_t row)
    {
        const uint64_t rowOffset = row * hiddenSize_;
        float sumSquares = 0.0f;

        for (uint32_t column = 0; column < hiddenSize_; column += tileElements_) {
            uint32_t remaining = hiddenSize_ - column;
            uint32_t valid = remaining < tileElements_ ? remaining : tileElements_;
            uint32_t aligned = AlignElements(valid);
            sumSquares += ReduceTile(rowOffset, column, valid, aligned);
        }

        const float mean = sumSquares * reciprocalD_ + epsilon_;
        auto calc = calcBuffer_.Get<float>();
        auto numeratorLocal = calc[tileElements_];
        auto denominatorLocal = calc[2 * tileElements_];
        AscendC::Duplicate(numeratorLocal, 1.0f, 8);
        AscendC::Duplicate(denominatorLocal, mean, 8);
        AscendC::Sqrt(denominatorLocal, denominatorLocal, 1);
        AscendC::Div(numeratorLocal, numeratorLocal, denominatorLocal, 1);
        AscendC::PipeBarrier<PIPE_ALL>();
        const float scale = numeratorLocal.GetValue(0);

        const bool singleTile = hiddenSize_ <= tileElements_;
        if (singleTile) {
            const uint32_t aligned = AlignElements(hiddenSize_);
            WriteSingleTile(rowOffset, hiddenSize_, aligned, scale);
            return;
        }
        for (uint32_t column = 0; column < hiddenSize_; column += tileElements_) {
            uint32_t remaining = hiddenSize_ - column;
            uint32_t valid = remaining < tileElements_ ? remaining : tileElements_;
            uint32_t aligned = AlignElements(valid);
            WriteTile(rowOffset, column, valid, aligned, scale);
        }
    }

private:
    AscendC::TPipe *pipe_ = nullptr;
    AscendC::TBuf<AscendC::QuePosition::VECIN> xBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECIN> residualBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECIN> gammaBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECIN> biasBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECOUT> outputBuffer_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> calcBuffer_;

    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> residualGm_;
    AscendC::GlobalTensor<T> gammaGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> outputGm_;

    uint64_t rowCount_ = 0;
    uint64_t firstRow_ = 0;
    uint64_t rowsForCore_ = 0;
    uint32_t hiddenSize_ = 0;
    uint32_t tileElements_ = 0;
    float epsilon_ = 1e-5f;
    float reciprocalD_ = 0.0f;
    bool parametersCached_ = false;
};

} // namespace AddRmsNormBiasBaseline

static inline bool BaselineSameShape(const TensorInfo& lhs, const TensorInfo& rhs)
{
    if (lhs.numDims != rhs.numDims) {
        return false;
    }
    for (int64_t dim = 0; dim < lhs.numDims; ++dim) {
        if (lhs.shape[dim] != rhs.shape[dim]) {
            return false;
        }
    }
    return true;
}

extern "C" __global__ __vector__ void add_rms_norm_bias_baseline(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rowCount, uint32_t hiddenSize, uint32_t tileElements,
    float epsilon, float reciprocalD, int32_t dtype)
{
    AscendC::TPipe pipe;
    if (dtype == 0) {
        AddRmsNormBiasBaseline::KernelAddRmsNormBias<float> op;
        op.Init(x, residual, gamma, bias, output, rowCount, hiddenSize,
                tileElements, epsilon, reciprocalD, &pipe);
        op.Process();
    } else if (dtype == 1) {
        AddRmsNormBiasBaseline::KernelAddRmsNormBias<half> op;
        op.Init(x, residual, gamma, bias, output, rowCount, hiddenSize,
                tileElements, epsilon, reciprocalD, &pipe);
        op.Process();
    } else if (dtype == 2) {
        AddRmsNormBiasBaseline::KernelAddRmsNormBias<bfloat16_t> op;
        op.Init(x, residual, gamma, bias, output, rowCount, hiddenSize,
                tileElements, epsilon, reciprocalD, &pipe);
        op.Process();
    }
}

extern "C" void run_baseline_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    if (info_x.numTensors != 1 || info_residual.numTensors != 1 ||
        info_gamma.numTensors != 1 || info_bias.numTensors != 1 ||
        info_output.numTensors != 1 || availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    const TensorInfo& residualInfo = info_residual.tensors[0];
    const TensorInfo& gammaInfo = info_gamma.tensors[0];
    const TensorInfo& biasInfo = info_bias.tensors[0];
    const TensorInfo& outputInfo = info_output.tensors[0];
    if (xInfo.numDims < 2 || xInfo.numDims > 4 ||
        (xInfo.dtype != 0 && xInfo.dtype != 1 && xInfo.dtype != 2)) {
        return;
    }
    if (!BaselineSameShape(xInfo, residualInfo) || !BaselineSameShape(xInfo, outputInfo) ||
        residualInfo.dtype != xInfo.dtype || outputInfo.dtype != xInfo.dtype ||
        gammaInfo.dtype != xInfo.dtype || biasInfo.dtype != xInfo.dtype ||
        gammaInfo.numDims != 1 || biasInfo.numDims != 1) {
        return;
    }

    uint64_t totalElements = 1;
    for (int64_t dim = 0; dim < xInfo.numDims; ++dim) {
        if (xInfo.shape[dim] <= 0) {
            return;
        }
        totalElements *= static_cast<uint64_t>(xInfo.shape[dim]);
    }

    const uint32_t hiddenSize = static_cast<uint32_t>(xInfo.shape[xInfo.numDims - 1]);
    if (gammaInfo.shape[0] != hiddenSize || biasInfo.shape[0] != hiddenSize) {
        return;
    }
    const uint64_t rowCount = totalElements / hiddenSize;
    const float reciprocalD = 1.0f / static_cast<float>(hiddenSize);
    const uint32_t elementBytes = xInfo.dtype == 0 ? 4 : 2;
    const uint32_t elementsPerBlock = AddRmsNormBiasBaseline::BLOCK_BYTES / elementBytes;
    uint32_t tileElements = std::min(hiddenSize, AddRmsNormBiasBaseline::MAX_TILE_ELEMENTS);
    tileElements = (tileElements + elementsPerBlock - 1) /
                   elementsPerBlock * elementsPerBlock;

    const uint32_t blockNum = static_cast<uint32_t>(
        std::min<uint64_t>(rowCount, static_cast<uint64_t>(availableCoreNum)));

    add_rms_norm_bias_baseline<<<blockNum, nullptr, stream>>>(
        x, residual, gamma, bias, output, rowCount, hiddenSize,
        tileElements, epsilon, reciprocalD, xInfo.dtype);
}


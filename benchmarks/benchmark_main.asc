#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <functional>
#include <iomanip>
#include <iostream>
#include <limits>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t *shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo *tensors;
    int64_t numTensors;
};
#endif

#include "../kernel.asc"
#include "kernel_baseline.asc"
#include "micro_kernels.asc"
#include "benchmark_stats.h"

#ifndef BENCHMARK_SOC_ARCH
#define BENCHMARK_SOC_ARCH "unknown"
#endif

namespace {

constexpr size_t SENTINEL_BYTES = 64;
constexpr uint8_t SENTINEL_VALUE = 0xA5;
constexpr uint32_t SAMPLE_BATCHES = 10;
constexpr uint32_t VECTOR_INNER_REPEATS = 256;

class AclError : public std::runtime_error {
public:
    AclError(const char *expression, aclError code)
        : std::runtime_error(BuildMessage(expression, code)), code_(code) {}
    aclError code() const { return code_; }

private:
    static std::string BuildMessage(const char *expression, aclError code)
    {
        std::ostringstream stream;
        stream << expression << " failed with aclError " << code;
        return stream.str();
    }
    aclError code_;
};

#define ACL_THROW(expression) do { \
    aclError _acl_result = (expression); \
    if (_acl_result != ACL_SUCCESS) throw AclError(#expression, _acl_result); \
} while (0)

class Event {
public:
    Event() { ACL_THROW(aclrtCreateEvent(&event_)); }
    ~Event() { if (event_ != nullptr) aclrtDestroyEvent(event_); }
    Event(const Event &) = delete;
    Event &operator=(const Event &) = delete;
    aclrtEvent get() const { return event_; }

private:
    aclrtEvent event_ = nullptr;
};

class DeviceBuffer {
public:
    explicit DeviceBuffer(size_t bytes) : bytes_(bytes)
    {
        if (bytes == 0) throw std::invalid_argument("device allocation must be nonzero");
        ACL_THROW(aclrtMalloc(&pointer_, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    ~DeviceBuffer() { if (pointer_ != nullptr) aclrtFree(pointer_); }
    DeviceBuffer(const DeviceBuffer &) = delete;
    DeviceBuffer &operator=(const DeviceBuffer &) = delete;
    void *get() const { return pointer_; }
    size_t size() const { return bytes_; }

private:
    void *pointer_ = nullptr;
    size_t bytes_ = 0;
};

class RuntimeContext {
public:
    explicit RuntimeContext(int32_t device) : device_(device)
    {
        ACL_THROW(aclInit(nullptr));
        initialized_ = true;
        ACL_THROW(aclrtSetDevice(device_));
        deviceSet_ = true;
        ACL_THROW(aclrtCreateStream(&stream_));
        ACL_THROW(aclrtGetDeviceInfo(device_, ACL_DEV_ATTR_VECTOR_CORE_NUM,
                                     &vectorCores_));
        if (vectorCores_ <= 0) {
            throw std::runtime_error("device reports no vector cores");
        }
    }
    ~RuntimeContext()
    {
        if (stream_ != nullptr) aclrtDestroyStream(stream_);
        if (deviceSet_) aclrtResetDevice(device_);
        if (initialized_) aclFinalize();
    }
    aclrtStream stream() const { return stream_; }
    int64_t vectorCores() const { return vectorCores_; }

private:
    int32_t device_ = 0;
    int64_t vectorCores_ = 0;
    aclrtStream stream_ = nullptr;
    bool initialized_ = false;
    bool deviceSet_ = false;
};

struct Options {
    std::string suite;
    std::string variant = "micro";
    std::string dtype = "fp16";
    uint64_t rows = 1;
    uint32_t hidden = 64;
    int32_t device = 0;
    uint32_t warmup = 100;
    uint32_t iterations = 1000;
    std::vector<int64_t> shape;
    bool validateOnly = false;
    std::string inputDir = ".";
    std::string output = "benchmark_results.csv";
};

struct ResultRow {
    std::string suite;
    std::string variant;
    std::string dtype;
    uint64_t rows = 0;
    uint32_t hidden = 0;
    uint64_t elements = 0;
    int32_t device = 0;
    std::string soc;
    int64_t vectorCores = 0;
    uint32_t warmup = 0;
    uint32_t iterations = 0;
    LatencyStats latency{0.0, 0.0, 0.0};
    uint64_t logicalBytes = 0;
    double effectiveGbps = 0.0;
    double gelementsPerSecond = 0.0;
    double checksum = 0.0;
    std::string status;
};

uint64_t ParseUnsigned(const std::string &value, const char *name)
{
    size_t consumed = 0;
    const uint64_t parsed = std::stoull(value, &consumed);
    if (consumed != value.size() || parsed == 0) {
        throw std::invalid_argument(std::string(name) + " must be a positive integer");
    }
    return parsed;
}

std::vector<int64_t> ParseShape(const std::string &value)
{
    std::vector<int64_t> shape;
    std::stringstream stream(value);
    std::string token;
    while (std::getline(stream, token, ',')) {
        shape.push_back(static_cast<int64_t>(ParseUnsigned(token, "shape dimension")));
    }
    if (shape.size() < 2 || shape.size() > 4) {
        throw std::invalid_argument("shape must contain 2 to 4 dimensions");
    }
    return shape;
}

Options ParseOptions(int argc, char **argv)
{
    Options options;
    auto value = [&](int &index) -> std::string {
        if (++index >= argc) throw std::invalid_argument("missing option value");
        return argv[index];
    };
    for (int i = 1; i < argc; ++i) {
        const std::string arg = argv[i];
        if (arg == "--suite") options.suite = value(i);
        else if (arg == "--variant") options.variant = value(i);
        else if (arg == "--dtype") options.dtype = value(i);
        else if (arg == "--rows") options.rows = ParseUnsigned(value(i), "rows");
        else if (arg == "--hidden") options.hidden = static_cast<uint32_t>(ParseUnsigned(value(i), "hidden"));
        else if (arg == "--device") options.device = std::stoi(value(i));
        else if (arg == "--warmup") options.warmup = static_cast<uint32_t>(ParseUnsigned(value(i), "warmup"));
        else if (arg == "--iterations") options.iterations = static_cast<uint32_t>(ParseUnsigned(value(i), "iterations"));
        else if (arg == "--shape") options.shape = ParseShape(value(i));
        else if (arg == "--input-dir") options.inputDir = value(i);
        else if (arg == "--output") options.output = value(i);
        else if (arg == "--validate-only") options.validateOnly = true;
        else throw std::invalid_argument("unknown option: " + arg);
    }

    const std::vector<std::string> suites = {
        "launch", "gm", "vector_add", "vector_mul", "reduction", "operator"};
    if (std::find(suites.begin(), suites.end(), options.suite) == suites.end()) {
        throw std::invalid_argument("suite must be launch, gm, vector_add, vector_mul, reduction, or operator");
    }
    if (options.dtype != "fp16" && options.dtype != "bf16" &&
        options.dtype != "fp32") {
        throw std::invalid_argument("dtype must be fp16, bf16, or fp32");
    }
    if (options.hidden < 1 || options.hidden > 32768) {
        throw std::invalid_argument("hidden must be in [1, 32768]");
    }
    if (!options.shape.empty()) {
        uint64_t rows = 1;
        for (size_t i = 0; i + 1 < options.shape.size(); ++i) {
            rows *= static_cast<uint64_t>(options.shape[i]);
        }
        if (rows != options.rows || options.shape.back() != options.hidden) {
            throw std::invalid_argument("shape must match rows and hidden");
        }
    }
    if (options.suite == "operator" && options.variant != "baseline" &&
        options.variant != "optimized") {
        throw std::invalid_argument("operator variant must be baseline or optimized");
    }
    if (options.suite != "operator" && options.variant != "micro") {
        throw std::invalid_argument("microbenchmark variant must be micro");
    }
    if ((options.suite == "vector_add" || options.suite == "vector_mul") &&
        options.dtype == "bf16") {
        throw std::invalid_argument("vector microbenchmark supports fp16 and fp32");
    }
    if (options.validateOnly && options.suite != "operator") {
        throw std::invalid_argument("validate-only is supported for operator suite");
    }
    return options;
}

int32_t DtypeCode(const std::string &dtype)
{
    if (dtype == "fp32") return 0;
    if (dtype == "fp16") return 1;
    return 2;
}

size_t DtypeBytes(const std::string &dtype)
{
    return dtype == "fp32" ? 4U : 2U;
}

std::vector<uint8_t> ReadBinary(const std::string &path, size_t bytes)
{
    std::ifstream file(path, std::ios::binary | std::ios::ate);
    if (!file) throw std::runtime_error("cannot open input: " + path);
    const std::streamoff size = file.tellg();
    if (size < 0 || static_cast<size_t>(size) != bytes) {
        throw std::runtime_error("unexpected input size: " + path);
    }
    file.seekg(0);
    std::vector<uint8_t> data(bytes);
    file.read(reinterpret_cast<char *>(data.data()), static_cast<std::streamsize>(bytes));
    if (!file) throw std::runtime_error("cannot read input: " + path);
    return data;
}

void WriteBinary(const std::string &path, const std::vector<uint8_t> &data,
                 size_t bytes)
{
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file) throw std::runtime_error("cannot open output: " + path);
    file.write(reinterpret_cast<const char *>(data.data()),
               static_cast<std::streamsize>(bytes));
    if (!file) throw std::runtime_error("cannot write output: " + path);
}

void CopyHostToDevice(DeviceBuffer &device, const std::vector<uint8_t> &host)
{
    ACL_THROW(aclrtMemcpy(device.get(), device.size(), host.data(), host.size(),
                          ACL_MEMCPY_HOST_TO_DEVICE));
}

std::vector<uint8_t> CopyDeviceToHost(const DeviceBuffer &device)
{
    std::vector<uint8_t> host(device.size());
    ACL_THROW(aclrtMemcpy(host.data(), host.size(), device.get(), device.size(),
                          ACL_MEMCPY_DEVICE_TO_HOST));
    return host;
}

void InitializeOutput(DeviceBuffer &output)
{
    ACL_THROW(aclrtMemset(output.get(), output.size(), SENTINEL_VALUE,
                          output.size()));
}

void CheckSentinel(const std::vector<uint8_t> &output, size_t logicalBytes)
{
    if (output.size() < logicalBytes + SENTINEL_BYTES) {
        throw std::runtime_error("output buffer is smaller than sentinel contract");
    }
    for (size_t i = logicalBytes; i < logicalBytes + SENTINEL_BYTES; ++i) {
        if (output[i] != SENTINEL_VALUE) {
            throw std::runtime_error("output sentinel changed at byte " +
                                     std::to_string(i - logicalBytes));
        }
    }
}

double ByteChecksum(const std::vector<uint8_t> &data, size_t bytes)
{
    double sum = 0.0;
    for (size_t i = 0; i < bytes; ++i) sum += data[i];
    return sum;
}

LatencyStats TimeKernel(aclrtStream stream, uint32_t warmup,
                        uint32_t iterations, const std::function<void()> &launch)
{
    for (uint32_t i = 0; i < warmup; ++i) launch();
    ACL_THROW(aclrtSynchronizeStream(stream));

    std::vector<double> samples;
    samples.reserve(SAMPLE_BATCHES);
    for (uint32_t batch = 0; batch < SAMPLE_BATCHES; ++batch) {
        Event start;
        Event end;
        ACL_THROW(aclrtRecordEvent(start.get(), stream));
        for (uint32_t i = 0; i < iterations; ++i) launch();
        ACL_THROW(aclrtRecordEvent(end.get(), stream));
        ACL_THROW(aclrtSynchronizeEvent(end.get()));
        float elapsedMs = 0.0f;
        ACL_THROW(aclrtEventElapsedTime(&elapsedMs, start.get(), end.get()));
        samples.push_back(ToPerLaunchUs(elapsedMs, iterations));
    }
    return ComputeLatencyStats(samples);
}

void AppendResult(const std::string &path, const ResultRow &row)
{
    bool writeHeader = true;
    {
        std::ifstream existing(path, std::ios::binary | std::ios::ate);
        writeHeader = !existing || existing.tellg() == 0;
    }
    std::ofstream file(path, std::ios::app);
    if (!file) throw std::runtime_error("cannot open result CSV: " + path);
    if (writeHeader) {
        file << "suite,variant,dtype,rows,hidden,elements,device,soc,vector_cores,"
             << "warmup,iterations,latency_us_min,latency_us_p50,latency_us_p90,"
             << "logical_bytes,effective_gbps,gelements_per_s,checksum,status\n";
    }
    file << std::setprecision(12)
         << row.suite << ',' << row.variant << ',' << row.dtype << ','
         << row.rows << ',' << row.hidden << ',' << row.elements << ','
         << row.device << ',' << row.soc << ',' << row.vectorCores << ','
         << row.warmup << ',' << row.iterations << ','
         << row.latency.minimum << ',' << row.latency.p50 << ',' << row.latency.p90
         << ',' << row.logicalBytes << ',';
    if (row.effectiveGbps > 0.0) file << row.effectiveGbps;
    file << ',';
    if (row.gelementsPerSecond > 0.0) file << row.gelementsPerSecond;
    file << ',' << row.checksum << ',' << row.status << '\n';
}

ResultRow MakeBaseResult(const Options &options, const RuntimeContext &runtime)
{
    ResultRow row;
    row.suite = options.suite;
    row.variant = options.variant;
    row.dtype = options.suite == "launch" ? "" : options.dtype;
    row.rows = options.rows;
    row.hidden = options.hidden;
    row.elements = options.rows * options.hidden;
    row.device = options.device;
    row.soc = BENCHMARK_SOC_ARCH;
    row.vectorCores = runtime.vectorCores();
    row.warmup = options.warmup;
    row.iterations = options.iterations;
    return row;
}

ResultRow RunOperator(const Options &options, RuntimeContext &runtime)
{
    const size_t elementBytes = DtypeBytes(options.dtype);
    const uint64_t elements = options.rows * options.hidden;
    const size_t tensorBytes = static_cast<size_t>(elements) * elementBytes;
    const size_t parameterBytes = static_cast<size_t>(options.hidden) * elementBytes;
    const int32_t dtype = DtypeCode(options.dtype);
    auto path = [&](const char *name) { return options.inputDir + "/" + name; };

    const auto xHost = ReadBinary(path("x.bin"), tensorBytes);
    const auto residualHost = ReadBinary(path("residual.bin"), tensorBytes);
    const auto gammaHost = ReadBinary(path("gamma.bin"), parameterBytes);
    const auto biasHost = ReadBinary(path("bias.bin"), parameterBytes);
    DeviceBuffer x(tensorBytes), residual(tensorBytes), gamma(parameterBytes),
        bias(parameterBytes), output(tensorBytes + SENTINEL_BYTES);
    CopyHostToDevice(x, xHost);
    CopyHostToDevice(residual, residualHost);
    CopyHostToDevice(gamma, gammaHost);
    CopyHostToDevice(bias, biasHost);
    InitializeOutput(output);

    std::vector<int64_t> shape = options.shape.empty()
        ? std::vector<int64_t>{static_cast<int64_t>(options.rows), options.hidden}
        : options.shape;
    int64_t parameterShape[] = {static_cast<int64_t>(options.hidden)};
    TensorInfo xTensor{shape.data(), static_cast<int64_t>(shape.size()), dtype};
    TensorInfo parameterTensor{parameterShape, 1, dtype};
    TensorGroupInfo xInfo{&xTensor, 1};
    TensorGroupInfo residualInfo{&xTensor, 1};
    TensorGroupInfo gammaInfo{&parameterTensor, 1};
    TensorGroupInfo biasInfo{&parameterTensor, 1};
    TensorGroupInfo outputInfo{&xTensor, 1};

    const auto launch = [&]() {
        if (options.variant == "baseline") {
            run_baseline_kernel((GM_ADDR)x.get(), xInfo,
                (GM_ADDR)residual.get(), residualInfo,
                (GM_ADDR)gamma.get(), gammaInfo,
                (GM_ADDR)bias.get(), biasInfo,
                (GM_ADDR)output.get(), outputInfo,
                runtime.vectorCores(), runtime.stream(), 1e-5f);
        } else {
            run_kernel((GM_ADDR)x.get(), xInfo,
                (GM_ADDR)residual.get(), residualInfo,
                (GM_ADDR)gamma.get(), gammaInfo,
                (GM_ADDR)bias.get(), biasInfo,
                (GM_ADDR)output.get(), outputInfo,
                runtime.vectorCores(), runtime.stream(), 1e-5f);
        }
    };

    ResultRow row = MakeBaseResult(options, runtime);
    if (options.validateOnly) {
        launch();
        ACL_THROW(aclrtSynchronizeStream(runtime.stream()));
    } else {
        row.latency = TimeKernel(runtime.stream(), options.warmup,
                                 options.iterations, launch);
    }
    const auto outputHost = CopyDeviceToHost(output);
    CheckSentinel(outputHost, tensorBytes);
    WriteBinary(path("actual_output.bin"), outputHost, tensorBytes);
    row.logicalBytes = 3 * tensorBytes + 2 * parameterBytes;
    row.effectiveGbps = options.validateOnly ? 0.0
        : static_cast<double>(row.logicalBytes) / (row.latency.p50 * 1000.0);
    row.checksum = ByteChecksum(outputHost, tensorBytes);
    row.status = "MEASURE_ONLY";
    return row;
}

void FillMicroInput(std::vector<uint8_t> &data, const std::string &dtype,
                    float value)
{
    if (dtype == "fp32") {
        float *typed = reinterpret_cast<float *>(data.data());
        for (size_t i = 0; i < data.size() / sizeof(float); ++i) typed[i] = value;
        return;
    }
    uint16_t bits = 0;
    if (dtype == "bf16") {
        if (value == 0.5f) bits = 0x3F00;
        else if (value > 0.99f) bits = 0x3F7F;
        else bits = 0x3A83;
    } else {
        if (value == 0.5f) bits = 0x3800;
        else if (value > 0.99f) bits = 0x3BFE;
        else bits = 0x1400;
    }
    uint16_t *typed = reinterpret_cast<uint16_t *>(data.data());
    for (size_t i = 0; i < data.size() / sizeof(uint16_t); ++i) typed[i] = bits;
}

ResultRow RunMicro(const Options &options, RuntimeContext &runtime)
{
    ResultRow row = MakeBaseResult(options, runtime);
    const uint64_t elements = options.rows * options.hidden;
    const size_t elementBytes = DtypeBytes(options.dtype);
    const size_t bytes = static_cast<size_t>(elements) * elementBytes;

    if (options.suite == "launch") {
        DeviceBuffer checksum(sizeof(float));
        ACL_THROW(aclrtMemset(checksum.get(), checksum.size(), 0, checksum.size()));
        const auto launch = [&]() {
            launch_noop_benchmark((GM_ADDR)checksum.get(),
                                  runtime.stream());
        };
        row.latency = TimeKernel(runtime.stream(), options.warmup,
                                 options.iterations, launch);
        const auto host = CopyDeviceToHost(checksum);
        float value = 0.0f;
        std::memcpy(&value, host.data(), sizeof(value));
        row.rows = 1;
        row.hidden = 1;
        row.elements = 1;
        row.logicalBytes = sizeof(float);
        row.checksum = value;
    } else if (options.suite == "gm") {
        std::vector<uint8_t> inputHost(bytes);
        for (size_t i = 0; i < bytes; ++i) inputHost[i] = static_cast<uint8_t>(i * 17U + 3U);
        DeviceBuffer input(bytes), output(bytes + SENTINEL_BYTES);
        CopyHostToDevice(input, inputHost);
        InitializeOutput(output);
        const auto launch = [&]() {
            launch_gm_copy_benchmark((GM_ADDR)input.get(),
                (GM_ADDR)output.get(), elements,
                DtypeCode(options.dtype), runtime.vectorCores(), runtime.stream());
        };
        row.latency = TimeKernel(runtime.stream(), options.warmup,
                                 options.iterations, launch);
        const auto outputHost = CopyDeviceToHost(output);
        CheckSentinel(outputHost, bytes);
        if (!std::equal(inputHost.begin(), inputHost.end(), outputHost.begin())) {
            throw std::runtime_error("GM copy output mismatch");
        }
        row.logicalBytes = 2 * bytes;
        row.checksum = ByteChecksum(outputHost, bytes);
    } else if (options.suite == "vector_add" || options.suite == "vector_mul") {
        std::vector<uint8_t> lhsHost(bytes), rhsHost(bytes);
        FillMicroInput(lhsHost, options.dtype, 0.5f);
        FillMicroInput(rhsHost, options.dtype,
                       options.suite == "vector_add" ? 0.001f : 0.999f);
        DeviceBuffer lhs(bytes), rhs(bytes), output(bytes + SENTINEL_BYTES);
        CopyHostToDevice(lhs, lhsHost);
        CopyHostToDevice(rhs, rhsHost);
        InitializeOutput(output);
        const VectorBenchOp op = options.suite == "vector_add"
            ? VectorBenchOp::ADD : VectorBenchOp::MUL;
        const auto launch = [&]() {
            launch_vector_benchmark((GM_ADDR)lhs.get(),
                (GM_ADDR)rhs.get(),
                (GM_ADDR)output.get(), elements,
                DtypeCode(options.dtype), op, VECTOR_INNER_REPEATS,
                runtime.vectorCores(), runtime.stream());
        };
        row.latency = TimeKernel(runtime.stream(), options.warmup,
                                 options.iterations, launch);
        const auto outputHost = CopyDeviceToHost(output);
        CheckSentinel(outputHost, bytes);
        row.logicalBytes = 3 * bytes;
        row.gelementsPerSecond =
            static_cast<double>(elements) * VECTOR_INNER_REPEATS /
            (row.latency.p50 * 1000.0);
        row.checksum = ByteChecksum(outputHost, bytes);
    } else {
        std::vector<uint8_t> inputHost(bytes);
        FillMicroInput(inputHost, options.dtype, 0.5f);
        DeviceBuffer input(bytes), sums(options.rows * sizeof(float));
        CopyHostToDevice(input, inputHost);
        ACL_THROW(aclrtMemset(sums.get(), sums.size(), 0, sums.size()));
        const auto launch = [&]() {
            launch_reduction_benchmark((GM_ADDR)input.get(),
                (GM_ADDR)sums.get(), options.rows,
                options.hidden, DtypeCode(options.dtype), runtime.vectorCores(),
                runtime.stream());
        };
        row.latency = TimeKernel(runtime.stream(), options.warmup,
                                 options.iterations, launch);
        const auto sumsHost = CopyDeviceToHost(sums);
        const float *typed = reinterpret_cast<const float *>(sumsHost.data());
        double checksum = 0.0;
        for (uint64_t i = 0; i < options.rows; ++i) checksum += typed[i];
        row.logicalBytes = bytes + options.rows * sizeof(float);
        row.gelementsPerSecond = static_cast<double>(elements) /
            (row.latency.p50 * 1000.0);
        row.checksum = checksum;
    }

    row.effectiveGbps = static_cast<double>(row.logicalBytes) /
        (row.latency.p50 * 1000.0);
    row.status = "PASS";
    if (row.latency.p50 <= 0.0 || !std::isfinite(row.checksum)) {
        throw std::runtime_error("invalid timing or checksum");
    }
    return row;
}

} // namespace

int main(int argc, char **argv)
{
    try {
        const Options options = ParseOptions(argc, argv);
        RuntimeContext runtime(options.device);
        ResultRow row = options.suite == "operator"
            ? RunOperator(options, runtime) : RunMicro(options, runtime);
        if (!options.validateOnly) AppendResult(options.output, row);
        std::cout << std::fixed << std::setprecision(3)
                  << options.suite << '/' << options.variant
                  << " p50=" << row.latency.p50 << "us checksum="
                  << row.checksum << std::endl;
        return 0;
    } catch (const std::exception &error) {
        std::cerr << "ERROR: " << error.what() << std::endl;
        return 1;
    }
}
